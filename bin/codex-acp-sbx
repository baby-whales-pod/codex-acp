#!/bin/sh
set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
project_dir=$(CDPATH= cd -- "$script_dir/.." && pwd)
sandbox_name=${CODEX_ACP_SANDBOX:-codex-acp}
workdir=${CODEX_ACP_WORKDIR:-$project_dir/workspace}

if ! command -v sbx >/dev/null 2>&1; then
  echo "codex-acp-sbx: sbx is not available on PATH" >&2
  exit 127
fi

if [ ! -d "$workdir" ]; then
  echo "codex-acp-sbx: workspace does not exist: $workdir" >&2
  exit 2
fi

exec sbx exec -i -w "$workdir" "$sandbox_name" codex-acp

